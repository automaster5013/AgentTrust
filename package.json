{
  "name": "agenttrust",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/server.js",
    "test": "node --env-file-if-exists=.env --test",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "worker": "node --env-file-if-exists=.env apps/worker/main.js",
    "docker:up": "docker compose up --build -d --wait",
    "docker:stop": "docker compose stop",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pg": "8.23.1"
  }
}
